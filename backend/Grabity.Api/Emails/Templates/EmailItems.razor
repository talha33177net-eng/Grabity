@* Ordered products with thumbnails, followed by the price breakdown. *@
<EmailSection Top="30">
    <p style="margin:0 0 4px;@Css.Text(12, 16, 700, EmailTheme.Muted)text-transform:uppercase;letter-spacing:0.7px;">@Heading</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        @foreach (var line in Lines)
        {
            <tr>
                <td width="66" valign="top" style="width:66px;padding:14px 0;border-bottom:1px solid @EmailTheme.Line;">
                    @if (line.ImageUrl is { } src)
                    {
                        <img src="@src" width="54" height="54" alt="" style="display:block;width:54px;height:54px;border-radius:12px;border:1px solid @EmailTheme.Line;background-color:#ffffff;object-fit:contain;" />
                    }
                    else
                    {
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="54" height="54" align="center" valign="middle" style="width:54px;height:54px;border-radius:12px;background-color:@EmailTheme.Panel;border:1px solid @EmailTheme.Line;font-size:22px;line-height:54px;">📦</td>
                            </tr>
                        </table>
                    }
                </td>
                <td valign="top" style="padding:14px 12px 14px 0;border-bottom:1px solid @EmailTheme.Line;">
                    <p style="margin:0;@Css.Text(14, 20, 600, EmailTheme.Ink)">
                        @if (line.Url is { } url)
                        {
                            <a href="@url" target="_blank" style="color:@EmailTheme.Ink;text-decoration:none;">@line.Name</a>
                        }
                        else
                        {
                            @line.Name
                        }
                    </p>
                    @if (line.Variant is { } variant)
                    {
                        <p style="margin:2px 0 0;@Css.Text(13, 18, 400, EmailTheme.Muted)">@variant</p>
                    }
                    <p style="margin:3px 0 0;@Css.Text(13, 18, 400, EmailTheme.Muted)">@($"Qty {line.Quantity} × {line.UnitPrice}")</p>
                    @if (line.ReviewUrl is { } review)
                    {
                        <p style="margin:7px 0 0;@Css.Text(13, 18, 700, Store.Theme.BrandStrong)"><a href="@review" target="_blank" style="color:@Store.Theme.BrandStrong;text-decoration:none;">★ Write a review</a></p>
                    }
                </td>
                <td valign="top" align="right" style="padding:14px 0;border-bottom:1px solid @EmailTheme.Line;white-space:nowrap;@Css.Text(14, 20, 700, EmailTheme.Ink)">@line.LineTotal</td>
            </tr>
        }
    </table>
    @if (Totals.Count > 0)
    {
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;">
            @foreach (var row in Totals)
            {
                var box = row.Strong ? $"padding:12px 0 4px;border-top:2px solid {EmailTheme.Line};" : "padding:5px 0;";
                var labelStyle = box + Css.Text(row.Strong ? 16 : 14, 22, row.Strong ? 800 : 400, row.Color ?? (row.Strong ? EmailTheme.Ink : EmailTheme.Muted));
                var valueStyle = box + "white-space:nowrap;" + Css.Text(row.Strong ? 18 : 14, 22, row.Strong ? 800 : 600, row.Color ?? EmailTheme.Ink);
                <tr>
                    <td style="@labelStyle">@row.Label</td>
                    <td align="right" style="@valueStyle">@row.Value</td>
                </tr>
            }
        </table>
    }
</EmailSection>

@code {
    [Parameter] public EmailStore Store { get; set; } = default!;
    [Parameter] public string Heading { get; set; } = "Order summary";
    [Parameter] public List<OrderEmailLine> Lines { get; set; } = [];
    [Parameter] public List<EmailTotal> Totals { get; set; } = [];
}
