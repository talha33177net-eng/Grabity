@* Shell for every email: a fluid 600px column with the store header, a white card, a help box and the footer.
   Tables and inline styles, because that is what Gmail, Outlook and phone mail apps render reliably. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>@Model.Subject</title>
    <style>
        body { margin: 0 !important; padding: 0 !important; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
        a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
        @@media only screen and (max-width: 620px) {
            .px { padding-left: 22px !important; padding-right: 22px !important; }
            .h1 { font-size: 23px !important; line-height: 30px !important; }
        }
    </style>
</head>
<body style="margin:0;padding:0;background-color:@EmailTheme.Canvas;">
    <div data-text-skip="true" style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">@(Model.Preheader)@(PreheaderPad)</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:@EmailTheme.Canvas;">
        <tr>
            <td align="center" style="padding:28px 12px 40px;">
                @MsoOpen
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;margin:0 auto;">
                    <tr>
                        <td style="padding:0 6px 18px;">
                            <a href="@(Store.BaseUrl)/" target="_blank" style="text-decoration:none;">
                                @if (Store.LogoUrl is { } logo)
                                {
                                    <img src="@logo" alt="@Store.Name" height="40" style="display:block;height:40px;width:auto;max-width:220px;border:0;" />
                                }
                                else
                                {
                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                        <tr>
                                            <td width="38" height="38" align="center" valign="middle" style="width:38px;height:38px;border-radius:11px;background-color:@Store.Theme.Brand;@Css.Text(20, 38, 800, "#ffffff")">@Initial</td>
                                            <td style="padding-left:10px;@Css.Text(20, 26, 800, EmailTheme.Ink)letter-spacing:-0.3px;">@Store.Name</td>
                                        </tr>
                                    </table>
                                }
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td style="background-color:#ffffff;border:1px solid @EmailTheme.Line;border-radius:18px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td height="5" style="height:5px;line-height:5px;font-size:0;background-color:@Store.Theme.Brand;border-radius:18px 18px 0 0;">&nbsp;</td>
                                </tr>
                            </table>
                            @ChildContent
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td height="36" style="height:36px;line-height:36px;font-size:0;">&nbsp;</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    @if (Model.ShowHelp && (Store.Phone is not null || Store.WhatsAppUrl is not null))
                    {
                        <tr>
                            <td style="padding:16px 0 0;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;border:1px solid @EmailTheme.Line;border-radius:14px;">
                                    <tr>
                                        <td style="padding:18px 22px;">
                                            <p style="margin:0 0 4px;@Css.Text(14, 20, 700, EmailTheme.Ink)">Need help?</p>
                                            <p style="margin:0;@Css.Text(13, 21, 400, EmailTheme.Muted)">
                                                @if (Store.Phone is { } phone)
                                                {
                                                    <span>Call </span><a href="tel:@PhoneHref" style="color:@Store.Theme.BrandStrong;font-weight:600;text-decoration:none;">@phone</a>
                                                }
                                                @if (Store.WhatsAppUrl is { } whatsApp)
                                                {
                                                    if (Store.Phone is not null)
                                                    {
                                                        <span> · </span>
                                                    }
                                                    <a href="@whatsApp" target="_blank" style="color:@Store.Theme.BrandStrong;font-weight:600;text-decoration:none;">WhatsApp us</a>
                                                }
                                                <span> · or just reply to this email.</span>
                                                @if (Store.BusinessHours is { } hours)
                                                {
                                                    <br />
                                                    <span>@hours</span>
                                                }
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td align="center" style="padding:24px 18px 0;@Css.Text(12, 19, 400, EmailTheme.Faint)">
                            @if (Store.Socials.Count > 0)
                            {
                                <p style="margin:0 0 10px;">
                                    @for (var i = 0; i < Store.Socials.Count; i++)
                                    {
                                        var social = Store.Socials[i];
                                        if (i > 0)
                                        {
                                            <span> · </span>
                                        }
                                        <a href="@social.Url" target="_blank" style="color:@EmailTheme.Muted;font-weight:600;text-decoration:none;">@social.Text</a>
                                    }
                                </p>
                            }
                            @if (Model.FooterNote is { } note)
                            {
                                <p style="margin:0 0 6px;">@note</p>
                            }
                            @if (Model.UnsubscribeUrl is { } unsubscribe)
                            {
                                <p style="margin:0 0 6px;"><a href="@unsubscribe" target="_blank" style="color:@EmailTheme.Muted;text-decoration:underline;">Unsubscribe</a></p>
                            }
                            <p style="margin:0;">@(Store.Address is { } address ? $"{Store.Name} · {address}" : Store.Name)</p>
                            @if (Store.Copyright is { } copyright)
                            {
                                <p style="margin:6px 0 0;">@($"© {DateTime.UtcNow.Year} {copyright}")</p>
                            }
                        </td>
                    </tr>
                </table>
                @MsoClose
            </td>
        </tr>
    </table>
</body>
</html>

@code {
    [Parameter] public EmailStore Store { get; set; } = default!;
    [Parameter] public EmailModelBase Model { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Outlook for Windows ignores max-width, so it gets a fixed 600px table through conditional comments.
    private static readonly MarkupString MsoOpen =
        new("<!--[if mso]><table role=\"presentation\" align=\"center\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->");
    private static readonly MarkupString MsoClose = new("<!--[if mso]></td></tr></table><![endif]-->");
    // Pads the inbox preview so mail apps don't append the start of the body after the preheader.
    private static readonly MarkupString PreheaderPad = new(string.Concat(Enumerable.Repeat("&#847;&zwnj;&nbsp;", 60)));

    private string Initial => Store.Name.Trim() is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "G";
    private string PhoneHref => new((Store.Phone ?? "").Where(c => char.IsDigit(c) || c == '+').ToArray());
}
