@* A simple list with an image, two lines of text and a status badge, e.g. low-stock products. *@
<EmailSection Top="20">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        @foreach (var row in Rows)
        {
            var (background, _, color) = Store.Theme.Tone(row.BadgeTone);
            <tr>
                <td width="60" valign="middle" style="width:60px;padding:12px 0;border-bottom:1px solid @EmailTheme.Line;">
                    @if (row.ImageUrl is { } src)
                    {
                        <img src="@src" width="48" height="48" alt="" style="display:block;width:48px;height:48px;border-radius:10px;border:1px solid @EmailTheme.Line;background-color:#ffffff;object-fit:contain;" />
                    }
                    else
                    {
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="48" height="48" align="center" valign="middle" style="width:48px;height:48px;border-radius:10px;background-color:@EmailTheme.Panel;border:1px solid @EmailTheme.Line;font-size:20px;line-height:48px;">📦</td>
                            </tr>
                        </table>
                    }
                </td>
                <td valign="middle" style="padding:12px 10px 12px 0;border-bottom:1px solid @EmailTheme.Line;">
                    <p style="margin:0;@Css.Text(14, 20, 600, EmailTheme.Ink)">
                        @if (row.Url is { } url)
                        {
                            <a href="@url" target="_blank" style="color:@EmailTheme.Ink;text-decoration:none;">@row.Title</a>
                        }
                        else
                        {
                            @row.Title
                        }
                    </p>
                    @if (row.Subtitle is { } subtitle)
                    {
                        <p style="margin:2px 0 0;@Css.Text(13, 18, 400, EmailTheme.Muted)">@subtitle</p>
                    }
                </td>
                <td valign="middle" align="right" style="padding:12px 0;border-bottom:1px solid @EmailTheme.Line;white-space:nowrap;">
                    @if (row.Badge is { } badge)
                    {
                        <span style="display:inline-block;padding:4px 10px;border-radius:999px;background-color:@background;@Css.Text(12, 16, 700, color)">@badge</span>
                    }
                </td>
            </tr>
        }
    </table>
</EmailSection>

@code {
    [Parameter] public EmailStore Store { get; set; } = default!;
    [Parameter] public List<EmailListRow> Rows { get; set; } = [];
}
