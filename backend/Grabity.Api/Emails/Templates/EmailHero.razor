<EmailSection Top="34">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td width="54" height="54" align="center" valign="middle" style="width:54px;height:54px;border-radius:15px;background-color:@Store.Theme.BrandSoft;font-size:27px;line-height:54px;">@Emoji</td>
        </tr>
    </table>
    <h1 class="h1" style="margin:20px 0 0;@Css.Text(26, 33, 800, EmailTheme.Ink)letter-spacing:-0.4px;">@Title</h1>
    @if (!string.IsNullOrWhiteSpace(Intro))
    {
        <p style="margin:10px 0 0;@Css.Text(15, 25)">@Intro</p>
    }
</EmailSection>

@code {
    [Parameter] public EmailStore Store { get; set; } = default!;
    [Parameter] public string Emoji { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Intro { get; set; }
}
