@* A "bulletproof" button: the coloured cell still shows where mail apps strip link padding. *@
<table role="presentation" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td align="center" bgcolor="@Store.Theme.BrandStrong" style="border-radius:11px;background-color:@Store.Theme.BrandStrong;">
            <a href="@Link.Url" target="_blank" style="display:inline-block;padding:14px 28px;border-radius:11px;@Css.Text(15, 20, 700, "#ffffff")text-decoration:none;">@Link.Text</a>
        </td>
    </tr>
</table>

@code {
    [Parameter] public EmailStore Store { get; set; } = default!;
    [Parameter] public EmailLink Link { get; set; } = default!;
}
