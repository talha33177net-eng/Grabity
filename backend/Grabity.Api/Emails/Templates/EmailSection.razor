@* A full-width block inside the email card with the standard side padding. *@
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="px" style="padding:@(Top)px 40px 0;">@ChildContent</td>
    </tr>
</table>

@code {
    [Parameter] public int Top { get; set; } = 24;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
